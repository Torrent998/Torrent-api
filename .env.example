# Non-secret examples only. NEVER commit real tokens/keys. Testnet/synthetic only.
APP_ENV=development
PORT=3001
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
TORRENT_ESCROW_CONTRACT_ID=
INDEXER_BASE_URL=http://localhost:3002
DATABASE_PATH=data/torrent-api.db
SUBMITTED_RECONCILE_AFTER_SECONDS=120
INTENT_TTL_SECONDS=900
LOG_LEVEL=info
AUDITOR_ADDRESSES=
# Browser origins allowed to call this API, exact and comma-separated (e.g. the Vercel app). Unset = no CORS headers.
# A malformed list stops the process at startup. A wildcard is refused.
CORS_ALLOWED_ORIGINS=
